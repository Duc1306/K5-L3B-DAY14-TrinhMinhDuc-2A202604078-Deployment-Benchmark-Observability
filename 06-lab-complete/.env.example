# ============================================================
# Biến môi trường của agent (tiêu chí 9) — KHÔNG ghi secret thật ở đây.
# Dùng local:  cp .env.example .env   (.env đã nằm trong .gitignore)
# Trên cloud:  đặt các biến này trên dashboard Railway / Render.
# ============================================================

# Server
PORT=8000
ENVIRONMENT=development
APP_VERSION=1.0.0
LOG_LEVEL=INFO
# Số uvicorn worker trong container (mặc định 2)
WEB_CONCURRENCY=2

# Security — bắt buộc khi ENVIRONMENT=production. Sinh key: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=

# Redis — rate limit + cost guard (docker compose tự ghi đè thành redis://redis:6379/0)
REDIS_URL=redis://localhost:6379/0

# Rate limit: số request / 60 giây cho mỗi API key
RATE_LIMIT_PER_MINUTE=10

# Cost guard (USD, tính theo giá token gpt-4o-mini)
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0
